
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin | Pura Magia</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101010;color:#fff;font-family:Arial,sans-serif;padding:20px}
main{max-width:900px;margin:auto}
h1{color:#e9ff63}
.card{background:#1c1c1c;padding:20px;border-radius:14px;margin:18px 0}
input,select,textarea,button{width:100%;padding:12px;margin:6px 0;border-radius:8px;border:1px solid #444;font:inherit}
input,select,textarea{background:#111;color:#fff}
button{background:#e9ff63;color:#111;font-weight:bold;cursor:pointer;border:0}
.secondary{background:#333;color:white}
.danger{background:#b83232;color:white}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
.product{border-top:1px solid #444;padding:14px 0;display:grid;grid-template-columns:70px 1fr;gap:12px}
.product img{width:70px;height:90px;object-fit:cover;border-radius:7px}
.smallbuttons{display:flex;gap:8px}
.smallbuttons button{flex:1}
.muted{color:#aaa;font-size:14px}
#app{display:none}
</style>
</head>
<body>
<main>
<h1>🪄 PURA MAGIA</h1>
<p>Panel privado de administración</p>

<section id="login" class="card">
<h2>Iniciar sesión</h2>
<form id="loginForm">
<input id="email" type="email" placeholder="Tu correo electrónico" required>
<input id="password" type="password" placeholder="Tu contraseña" required>
<button type="submit">Entrar al panel</button>
</form>
<p id="loginMessage" class="muted"></p>
</section>

<section id="app">
<div class="card">
<div class="grid">
<div>
<h2>Productos</h2>
<p class="muted">Agregá y administrá tu catálogo.</p>
</div>
<div>
<button id="logout" class="secondary">Cerrar sesión</button>
<button id="store" class="secondary">Ver tienda</button>
</div>
</div>
</div>

<div class="card">
<h2 id="formTitle">Agregar producto</h2>
<form id="productForm">
<input id="name" placeholder="Nombre del producto" required>
<textarea id="description" placeholder="Descripción de la prenda"></textarea>
<div class="grid">
<input id="price" type="number" min="0" step="0.01" placeholder="Precio en pesos" required>
<input id="stock" type="number" min="0" step="1" placeholder="Stock disponible" required>
</div>
<input id="image" type="url" placeholder="URL de la foto (https://...)" required>
<label for="category">Categoría</label>
<select id="category">
<option value="">Sin categoría</option>
</select>
<label><input id="active" type="checkbox" checked style="width:auto"> Producto visible en la tienda</label>
<button id="saveProduct" type="submit">Guardar producto</button>
<button id="cancelEdit" type="button" class="secondary" hidden>Cancelar edición</button>
</form>
<p id="productMessage" class="muted"></p>
</div>

<div class="card">
<h2>Categorías</h2>
<form id="categoryForm">
<input id="categoryName" placeholder="Nueva categoría (ej. Buzos)" required>
<button type="submit">Crear categoría</button>
</form>
<p id="categoryMessage" class="muted"></p>
</div>

<div class="card">
<h2>Catálogo actual</h2>
<button id="reload" class="secondary">Actualizar catálogo</button>
<div id="products"></div>
</div>
</section>
</main>

<script>
const SUPABASE_URL = "https://hcnjnzpmlydhjnsdvzyh.supabase.co";
const SUPABASE_KEY = "sb_publishable_w5yT150xEdZuz3Ob6BRpng_vgiqrBN_";
const STORE_URL = "https://lautrix205-ux.github.io/indumentaria-pura-magia-/";

let accessToken = "";
let editingId = null;
let categories = [];

const $ = id => document.getElementById(id);

async function api(path, options = {}) {
  const headers = {
    apikey: SUPABASE_KEY,
    Authorization: "Bearer " + (accessToken || SUPABASE_KEY),
    ...(options.body ? {"Content-Type":"application/json"} : {}),
    ...(options.headers || {})
  };

  const response = await fetch(SUPABASE_URL + path, {
    ...options,
    headers
  });

  const text = await response.text();
  if (!response.ok) {
    let message = text;
    try {
      const data = JSON.parse(text);
      message = data.message || data.msg || text;
    } catch {}
    throw new Error("Error " + response.status + ": " + message);
  }

  return text ? JSON.parse(text) : null;
}

function message(id, text) {
  $(id).textContent = text;
}

async function login(email, password) {
  const response = await fetch(
    SUPABASE_URL + "/auth/v1/token?grant_type=password",
    {
      method:"POST",
      headers:{
        apikey:SUPABASE_KEY,
        "Content-Type":"application/json"
      },
      body:JSON.stringify({email,password})
    }
  );

  const data = await response.json();
  if (!response.ok) {
    throw new Error(data.msg || data.message || "No se pudo iniciar sesión.");
  }

  accessToken = data.access_token;

  const isAdmin = await api("/rest/v1/rpc/is_admin", {
    method:"POST",
    body:"{}"
  });

  if (isAdmin !== true) {
    accessToken = "";
    throw new Error("Esta cuenta no tiene permisos de administrador.");
  }

  $("login").style.display = "none";
  $("app").style.display = "block";
  $("password").value = "";

  await loadCategories();
  await loadProducts();
}

async function loadCategories() {
  categories = await api(
    "/rest/v1/categories?select=id,name&order=name.asc"
  );

  const select = $("category");
  const current = select.value;
  select.replaceChildren(new Option("Sin categoría", ""));

  categories.forEach(category => {
    select.add(new Option(category.name, category.id));
  });

  if ([...select.options].some(option => option.value === current)) {
    select.value = current;
  }
}

function resetForm() {
  editingId = null;
  $("productForm").reset();
  $("active").checked = true;
  $("formTitle").textContent = "Agregar producto";
  $("saveProduct").textContent = "Guardar producto";
  $("cancelEdit").hidden = true;
}

async function loadProducts() {
  $("products").textContent = "Cargando productos...";

  try {
    const products = await api(
      "/rest/v1/products?select=id,name,description,price,image_url,category_id,stock,active&order=id.desc"
    );

    const container = $("products");
    container.replaceChildren();

    if (!products.length) {
      container.textContent = "Todavía no hay productos.";
      return;
    }

    products.forEach(product => {
      const item = document.createElement("div");
      item.className = "product";

      const img = document.createElement("img");
      img.alt = product.name;
      img.src = product.image_url || "";
      img.onerror = () => { img.style.visibility = "hidden"; };

      const details = document.createElement("div");
      const title = document.createElement("strong");
      title.textContent = product.name;

      const info = document.createElement("p");
      info.textContent =
        "$" + Number(product.price).toLocaleString("es-AR") +
        " · Stock: " + product.stock +
        " · " + (product.active ? "Visible" : "Oculto");

      const buttons = document.createElement("div");
      buttons.className = "smallbuttons";

      const edit = document.createElement("button");
      edit.textContent = "Editar";
      edit.onclick = () => editProduct(product);

      const remove = document.createElement("button");
      remove.textContent = "Eliminar";
      remove.className = "danger";
      remove.onclick = () => deleteProduct(product);

      buttons.append(edit, remove);
      details.append(title, info, buttons);
      item.append(img, details);
      container.append(item);
    });
  } catch (error) {
    message("productMessage", error.message);
    $("products").textContent = "No se pudo cargar el catálogo.";
  }
}

function editProduct(product) {
  editingId = product.id;
  $("name").value = product.name || "";
  $("description").value = product.description || "";
  $("price").value = product.price;
  $("stock").value = product.stock;
  $("image").value = product.image_url || "";
  $("category").value = product.category_id ?? "";
  $("active").checked = product.active;
  $("formTitle").textContent = "Editar producto";
  $("saveProduct").textContent = "Guardar cambios";
  $("cancelEdit").hidden = false;
  window.scrollTo({top:0,behavior:"smooth"});
}

async function deleteProduct(product) {
  if (!confirm('¿Eliminar "' + product.name + '"?')) return;

  try {
    await api("/rest/v1/products?id=eq." + product.id, {
      method:"DELETE"
    });
    message("productMessage", "Producto eliminado.");
    await loadProducts();
  } catch (error) {
    message("productMessage", error.message);
  }
}

$("loginForm").addEventListener("submit", async event => {
  event.preventDefault();
  message("loginMessage", "Verificando acceso...");

  try {
    await login($("email").value.trim(), $("password").value);
    message("loginMessage", "");
  } catch (error) {
    message("loginMessage", error.message);
  }
});

$("productForm").addEventListener("submit", async event => {
  event.preventDefault();

  const product = {
    name:$("name").value.trim(),
    description:$("description").value.trim(),
    price:Number($("price").value),
    image_url:$("image").value.trim(),
    category_id:$("category").value ? Number($("category").value) : null,
    stock:Number($("stock").value),
    active:$("active").checked
  };

  try {
    if (editingId !== null) {
      await api("/rest/v1/products?id=eq." + editingId, {
        method:"PATCH",
        headers:{"Prefer":"return=minimal"},
        body:JSON.stringify(product)
      });
      message("productMessage", "¡Producto actualizado!");
    } else {
      await api("/rest/v1/products", {
        method:"POST",
        headers:{"Prefer":"return=minimal"},
        body:JSON.stringify(product)
      });
      message("productMessage", "¡Producto agregado!");
    }

    resetForm();
    await loadProducts();
  } catch (error) {
    message("productMessage", error.message);
  }
});

$("categoryForm").addEventListener("submit", async event => {
  event.preventDefault();

  try {
    await api("/rest/v1/categories", {
      method:"POST",
      headers:{"Prefer":"return=minimal"},
      body:JSON.stringify({name:$("categoryName").value.trim()})
    });

    $("categoryName").value = "";
    message("categoryMessage", "¡Categoría creada!");
    await loadCategories();
  } catch (error) {
    message("categoryMessage", error.message);
  }
});

$("cancelEdit").addEventListener("click", resetForm);
$("reload").addEventListener("click", async () => {
  try {
    await loadCategories();
    await loadProducts();
  } catch (error) {
    message("productMessage", error.message);
  }
});

$("logout").addEventListener("click", () => {
  accessToken = "";
  editingId = null;
  $("app").style.display = "none";
  $("login").style.display = "block";
  message("loginMessage", "Sesión cerrada.");
});

$("store").addEventListener("click", () => {
  window.open(STORE_URL, "_blank", "noopener");
});
</script>
</body>
</html>
